{
  "name": "editra",
  "version": "1.0.0",
  "description": "Premium WYSIWYG Editor for the Web",
  "main": "index.js",
  "module": "index.mjs",
  "browser": "dist/editra.js",
  "unpkg": "dist/editra.js",
  "jsdelivr": "dist/editra.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./dist/editra.js": "./dist/editra.js",
    "./themes/premium.css": "./themes/premium.css",
    "./core/editor.js": "./core/editor.js",
    "./plugins/*": "./plugins/*",
    "./ui/*": "./ui/*"
  },
  "files": [
    "index.js",
    "index.mjs",
    "dist",
    "core",
    "plugins",
    "ui",
    "themes",
    "docs",
    "examples",
    "README.md",
    "LICENSE.md",
    "RELEASE_NOTES.md",
    "version.prop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editra-js/Editra.git"
  },
  "bugs": {
    "url": "https://github.com/editra-js/Editra/issues"
  },
  "homepage": "https://github.com/editra-js/Editra#readme",
  "keywords": [
    "wysiwyg",
    "editor",
    "html",
    "pdf",
    "word"
  ],
  "author": "Editra Team",
  "license": "MIT",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "test": "jest --runInBand && node tests/automation/verify-project.js && node tests/unit/core-contract.test.js && node tests/unit/distribution-contract.test.js",
    "pack:check": "npm pack --dry-run --cache ./.npm-cache",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.0"
  }
}
