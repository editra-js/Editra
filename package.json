{
  "name": "@editra-js/editra",
  "version": "2.0.0",
  "description": "Premium WYSIWYG Editor for the Web",
  "main": "index.js",
  "module": "index.mjs",
  "browser": "dist/editra.js",
  "unpkg": "dist/editra.js",
  "jsdelivr": "dist/editra.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./dist/editra.js": "./dist/editra.js",
    "./dist/editra.min.js": "./dist/editra.min.js",
    "./themes/premium.css": "./themes/premium.css",
    "./themes/premium.min.css": "./themes/premium.min.css",
    "./core/editor.js": "./core/editor.js",
    "./core/security.js": "./core/security.js",
    "./assets/*": "./assets/*",
    "./plugins/*": "./plugins/*",
    "./ui/*": "./ui/*"
  },
  "files": [
    "index.js",
    "index.mjs",
    "dist",
    "core",
    "plugins",
    "ui",
    "themes",
    "assets",
    "vendor",
    "docs",
    "examples",
    "README.md",
    "LICENSE.md",
    "RELEASE_NOTES.md",
    "version.prop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editra-js/Editra.git"
  },
  "bugs": {
    "url": "https://github.com/editra-js/Editra/issues"
  },
  "homepage": "https://github.com/editra-js/Editra#readme",
  "keywords": [
    "wysiwyg",
    "editor",
    "html",
    "pdf",
    "word"
  ],
  "author": "Editra Team",
  "license": "MIT",
  "scripts": {
    "sync:headers": "node tools/update-version-headers.js",
    "build": "npm run sync:headers && node tools/sync-vendor.js && webpack --config webpack.config.js && node tools/generate-minified-assets.js && npm run sync:headers",
    "test": "npm run test:unit && npm run test:browser:installed",
    "test:unit": "node --test tests/unit/entry.test.js && node tests/automation/verify-project.js && node tests/unit/core-contract.test.js && node tests/unit/distribution-contract.test.js && node tests/unit/security-contract.test.js",
    "test:browser:installed": "node tests/automation/browser-security.js",
    "test:cross-browser": "playwright test",
    "security:audit": "npm audit --audit-level=high",
    "pack:check": "npm pack --dry-run --cache ./.npm-cache",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "webpack": "5.109.0",
    "webpack-cli": "6.0.1"
  },
  "dependencies": {
    "dompurify": "3.4.12"
  }
}
